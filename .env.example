# Copy to .env and adjust. Every setting is optional; defaults are in ktrade/config.py.

# Claude Code CLI. Use the absolute path when running as a background service (launchd/systemd have a short PATH).
# Find it with: which claude
KTRADE_CLAUDE_BIN=claude
KTRADE_CLAUDE_MODEL=sonnet
KTRADE_CLAUDE_WEB=true

# Paper money per book (the AI book and the rules-only baseline each start with this).
KTRADE_START_EQUITY=1000

# Risk engine (applies to both books; Claude cannot change it)
KTRADE_RISK_PER_TRADE=0.005
KTRADE_MAX_POSITIONS=3
KTRADE_DAILY_LOSS_LIMIT=0.03

# Universe
KTRADE_MIN_TURNOVER_USD=5000000
KTRADE_MIN_LISTING_DAYS=60
# KTRADE_EXCLUDE=XAUTUSD,PAXGUSD

# Dashboard. Set a token before exposing it through a tunnel or reverse proxy.
KTRADE_PORT=8060
KTRADE_PANEL_TOKEN=

# Claude agent: Claude decides everything inside hard caps, on a real Delta account.
# demo = Delta testnet (fake money, https://demo.delta.exchange). live = real money; also needs the phrase below.
KTRADE_AGENT_ENABLED=false
KTRADE_AGENT_MODE=demo
KTRADE_DELTA_KEY=
KTRADE_DELTA_SECRET=
# KTRADE_AGENT_LIVE_CONFIRM=I accept that I can lose this money
# KTRADE_AGENT_MAX_RISK_PCT=5
# KTRADE_AGENT_MAX_LEVERAGE=10
# KTRADE_AGENT_MAX_POSITIONS=3
# KTRADE_AGENT_MAX_ENTRIES_PER_DAY=6
# KTRADE_AGENT_DAILY_LOSS_PCT=15
# KTRADE_AGENT_FLOOR_EQUITY=50
